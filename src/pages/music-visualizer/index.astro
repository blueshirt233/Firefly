---
// 音乐可视化 — sonic-topography 全屏嵌入
// 进入页面时暂停博客 MusicPlayer, 可视化不自动播放
import I18nKey from "@/i18n/i18nKey"
import { i18n } from "@/i18n/translation"
const title = i18n(I18nKey.musicVisualizer)
---
<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <style>
    html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:#000}
    iframe{border:none;width:100%;height:100%}
  </style>
</head>
<body>
  <iframe src="/sonic-topography/index.html" allow="autoplay"></iframe>
</body>
</html>
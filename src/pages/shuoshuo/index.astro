---
import { getCollection, render } from "astro:content"
import { Icon } from "astro-icon/components"
import FancyboxManager from "@/components/features/FancyboxManager.astro"
import MainGridLayout from "@/layouts/MainGridLayout.astro"
import type { MarkdownHeading } from "astro"
import { fontConfig, profileConfig } from "@/config"
import I18nKey from "@/i18n/i18nKey"
import { i18n } from "@/i18n/translation"
import { renderVideoHtml } from "@/utils/shuoshuo-utils"

const headings: MarkdownHeading[] = []
const allItems = await getCollection("shuoshuo", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true
})
const sorted = allItems.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1
  if (!a.data.pinned && b.data.pinned) return 1
  return new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
})

const rendered = await Promise.all(
  sorted.map(async (item) => {
    const { Content } = await render(item)
    return { ...item, Content }
  })
)

const tagMap = new Map<string, number>()
rendered.forEach(item => {
  if (item.data.tags) {
    item.data.tags.forEach(tag => {
      tagMap.set(tag, (tagMap.get(tag) || 0) + 1)
    })
  }
})
const allTags = Array.from(tagMap.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }))

const bodyFontVar = fontConfig.shuoshuoBodyFont ||
  (Array.isArray(fontConfig.selected) ? fontConfig.selected[0] : fontConfig.selected)
const bodyFontFamily = bodyFontVar && bodyFontVar !== "system"
  ? `var(${bodyFontVar}), sans-serif`
  : "var(--font-inter), sans-serif"

const total = rendered.length
---

<MainGridLayout
  title={i18n(I18nKey.shuoshuo)}
  description={i18n(I18nKey.shuoshuoDescription)}
  headings={headings}
>

  <!-- ═══ 顶部标题卡片 ═══ -->
  <div class="card-base rounded-(--radius-xl) px-8 py-6 mb-4 bg-(--primary)">
    <div class="flex justify-between items-center">
      <div>
        <div class="text-2xl font-bold text-white">
          {i18n(I18nKey.shuoshuo)}
        </div>
        <div class="text-sm text-white/80 mt-1">
          随时随地，分享生活
        </div>
      </div>
      <div class="text-right">
        <div class="text-3xl font-bold text-white" id="shuoshuo-total">
          {total}
        </div>
        <div class="text-xs text-white/70 mt-0.5">
          条说说
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ 标签过滤栏 ═══ -->
  {allTags.length > 0 && (
    <div class="card-base rounded-(--radius-xl) px-6 py-3 mb-4" id="shuoshuo-tag-bar">
      <div class="flex flex-wrap gap-2">
        <button
          class="shuoshuo-bar-btn rounded-full px-4 py-1.5 text-sm font-medium
                 transition-all duration-200 hover:scale-105 active:scale-95
                 flex items-center gap-1.5
                 bg-(--primary)/10 text-(--primary)"
          style="background: var(--primary); color: white"
          data-tag=""
        >
          <Icon is:inline
                name="material-symbols:grid-view-outline-rounded"
                class="text-base" />
          说说 ({total})
        </button>
        {allTags.map(tag => (
          <button
            class="shuoshuo-bar-btn rounded-full px-4 py-1.5 text-sm font-medium
                   transition-all duration-200 hover:scale-105 active:scale-95
                   bg-(--primary)/10 text-(--primary)"
            data-tag={tag.name}
          >
            {tag.name} ({tag.count})
          </button>
        ))}
      </div>
    </div>
  )}

  <!-- ═══ 说说卡片列表 ═══ -->
  <div class="flex flex-col gap-4" id="shuoshuo-list">
    {rendered.length === 0 ? (
      <div class="card-base rounded-(--radius-large) p-12 text-center text-(--content-meta)">
        <Icon is:inline name="material-symbols:chat-bubble-outline-rounded"
              class="text-5xl mb-3 opacity-40" />
        <p>{i18n(I18nKey.shuoshuoNoContent)}</p>
      </div>
    ) : (
      rendered.map((item) => {
        const images: string[] = item.data.images || []
        const videos = item.data.videos || []
        const hasImages = images.length > 0
        const hasVideos = videos.length > 0
        const tagList: string[] = item.data.tags || []

        return (
          <div
            class="card-base rounded-(--radius-large) p-5 md:p-6 relative shuoshuo-card"
            data-tags={tagList.join(",")}
          >
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-(--primary) flex items-center
                          justify-center text-white font-bold shrink-0">
                F
              </div>
              <div class="flex-1 min-w-0">
                <div class="font-bold text-sm text-black/75 dark:text-white/75">
                  {profileConfig.name}
                </div>
                <div class="text-xs text-(--content-meta)">
                  {new Date(item.data.published).toLocaleDateString("zh-CN", {
                    year: "numeric", month: "long", day: "numeric",
                    hour: "2-digit", minute: "2-digit",
                  })}
                </div>
              </div>
              {item.data.pinned && (
                <span class="text-xs px-2 py-0.5 rounded-full
                             bg-(--primary)/10 text-(--primary) font-medium shrink-0">
                  {i18n(I18nKey.pinned)}
                </span>
              )}
            </div>

            <div
              class="text-base text-black/80 dark:text-white/80 leading-relaxed
                     mb-4 markdown-content shuoshuo-body"
              style={`font-family: ${bodyFontFamily}`}
            >
              <item.Content />
            </div>

            {hasImages && (
              <div class="grid gap-1 rounded-xl overflow-hidden mb-4"
                   style={`grid-template-columns: repeat(${Math.min(images.length, 3)}, 1fr)`}>
                {images.slice(0, 9).map((img, idx) => {
                  const isOverflow = idx === 8 && images.length > 9
                  return (
                    <a href={img}
                       data-fancybox={`shuoshuo-${item.id}`}
                       class="block relative aspect-square overflow-hidden
                              bg-black/5 dark:bg-white/5">
                      <img src={img} alt="" loading="lazy" decoding="async"
                           class="w-full h-full object-cover hover:scale-105
                                  transition-transform duration-300" />
                      {isOverflow && (
                        <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
                          <span class="text-white text-xl font-bold">+{images.length - 9}</span>
                        </div>
                      )}
                    </a>
                  )
                })}
              </div>
            )}

            {hasVideos && (
              <div class="flex flex-col gap-3 mb-4">
                {videos.map((video: any) => (
                  <div class="rounded-xl overflow-hidden bg-black">
                    <Fragment set:html={renderVideoHtml({
                      type: video.type as "bilibili" | "youtube" | "direct",
                      bvid: video.bvid,
                      youtubeId: video.youtubeId,
                      src: video.src,
                      title: video.title,
                    })} />
                  </div>
                ))}
              </div>
            )}

            {tagList.length > 0 && (
              <div class="flex flex-wrap justify-end gap-1.5 mt-2 pt-3
                          border-t border-(--line-divider)">
                {tagList.map((tag: string) => (
                  <button
                    class="shuoshuo-card-tag text-xs px-2.5 py-1 rounded-full
                           bg-(--enter-btn-bg) text-(--primary)
                           hover:bg-(--primary)/20 hover:scale-105
                           active:scale-95 transition-all duration-200 font-medium"
                    data-tag={tag}
                  >
                    {tag}
                  </button>
                ))}
              </div>
            )}
          </div>
        )
      })
    )}
  </div>

  <FancyboxManager />
</MainGridLayout>

<style is:global>
  .shuoshuo-body { line-height: 1.75; }
  .shuoshuo-body p { margin-bottom: 0.75em; }
  .shuoshuo-body a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .shuoshuo-body a:hover { opacity: 0.8; }
  .shuoshuo-body img { display: none; }
  .shuoshuo-body code {
    font-family: var(--font-jetbrains-mono), monospace;
    font-size: 0.9em;
    background: var(--inline-code-bg);
    color: var(--inline-code-color);
    padding: 0.1em 0.3em;
    border-radius: 0.3em;
  }
</style>

<script is:inline>
  (function () {
    function run() {
      var bar = document.getElementById("shuoshuo-tag-bar")
      var cards = document.querySelectorAll(".shuoshuo-card")
      var totalEl = document.getElementById("shuoshuo-total")
      if (!bar || !cards.length || !totalEl) return

      var barButtons = bar.querySelectorAll(".shuoshuo-bar-btn")

      function activate(btn) {
        barButtons.forEach(function (b) {
          b.style.backgroundColor = ""
          b.style.color = ""
        })
        btn.style.backgroundColor = "var(--primary)"
        btn.style.color = "white"
      }

      function filterByTag(tag) {
        var n = 0
        cards.forEach(function (c) {
          var ct = (c.getAttribute("data-tags") || "").split(",")
          if (!tag || ct.indexOf(tag) >= 0) { c.style.display = ""; n++ }
          else { c.style.display = "none" }
        })
        totalEl.textContent = n
      }

      barButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          var t = this.getAttribute("data-tag") || ""
          activate(this)
          filterByTag(t)
        })
      })

      document.querySelectorAll(".shuoshuo-card-tag").forEach(function (btn) {
        btn.addEventListener("click", function (e) {
          e.stopPropagation()
          var t = this.getAttribute("data-tag") || ""
          var bb = bar.querySelector('.shuoshuo-bar-btn[data-tag="' + t.replace(/"/g, "") + '"]')
          if (bb) activate(bb)
          filterByTag(t)
        })
      })
    }

    document.addEventListener("astro:page-load", function () { setTimeout(run, 1) })
  })()
</script>